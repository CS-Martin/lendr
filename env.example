# Enable testnet support (includes Sepolia)
NEXT_PUBLIC_ENABLE_TESTNETS=true

# Alchemy configuration - REQUIRED for NFT functionality
# Get your API key from: https://dashboard.alchemy.com/
# Make sure your Alchemy app has the NFT API enabled for all supported chains
NEXT_PUBLIC_ALCHEMY_API_KEY=your-alchemy-api-key

# Convex configuration
CONVEX_DEPLOYMENT=dev
NEXT_PUBLIC_CONVEX_URL=

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Optional: Custom RPC URLs for better performance
# NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
# NEXT_PUBLIC_MAINNET_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Web3Auth configuration
# Get your Client ID from the Web3Auth Dashboard
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=your-web3auth-client-id
# One of: SAPPHIRE_MAINNET or SAPPHIRE_DEVNET
NEXT_PUBLIC_WEB3AUTH_NETWORK=SAPPHIRE_DEVNET

# Smart Contract Deployment (for Makefile usage)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
PRIVATE_KEY=your-private-key-here
ETHERSCAN_API_KEY=your-etherscan-api-key-here

# ========================================
# SUPPORTED CHAINS FOR NFT DISPLAY:
# ========================================
# The app supports NFT fetching on these chains via Alchemy:
# - Ethereum Mainnet (Chain ID: 1)
# - Ethereum Sepolia (Chain ID: 11155111) 
# - Optimism (Chain ID: 10)
# - Arbitrum One (Chain ID: 42161)
# - Polygon (Chain ID: 137)
# - Base (Chain ID: 8453)
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env.local
# 2. Get your Alchemy API key from https://dashboard.alchemy.com/
# 3. Replace 'your-alchemy-api-key' with your actual API key
# 4. Ensure your Alchemy app has NFT API enabled
# ========================================
